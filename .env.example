PORT=5000
MONGO_URI=mongodb://localhost:27017/lms_academy
SHEETDB_URL=https://sheetdb.io/api/v1/your_sheet_id
OPENAI_API_KEY=your_openai_api_key
# אופציונלי: דומיין חיצוני שמורשה לקרוא ל-API (למשל אתר נחיתה נפרד). ריק = רק האתר עצמו
ALLOWED_ORIGIN=
# --- חומת תשלום והתחברות עם Google ---
# on = להפעיל. פועל רק אם GOOGLE_CLIENT_ID, SESSION_SECRET ו-SHEETDB_URL מוגדרים; אחרת הכול פתוח
PAYWALL=
# Client ID מ-Google Cloud Console (סוג Web application)
GOOGLE_CLIENT_ID=
# מחרוזת אקראית ארוכה (לפחות 32 תווים) לחתימת עוגיות ההתחברות
SESSION_SECRET=
# כמה מודולים ראשונים פתוחים בחינם (ברירת מחדל 3)
FREE_MODULES=3
# המחיר שיוצג באתר, למשל: 35 ₪
COURSE_PRICE=
# קישור לעמוד התשלום
CHECKOUT_URL=
# קודי גישה חד-פעמיים, מופרדים בפסיקים (ליצירה: npm run codes -- 20)
ACCESS_CODES=
# אימיילים עם גישה מלאה תמיד (למשל שלך), מופרדים בפסיקים
OWNER_EMAILS=
# אימייל ליצירת קשר שיוצג בדף מדיניות הפרטיות (/privacy)
CONTACT_EMAIL=
# 💳 Grow: קליטת תשלומים אוטומטית (Webhook). הכתובת שנותנים לתמיכה של Grow:
# https://<האתר>/api/webhooks/grow/<GROW_WEBHOOK_SECRET>   (סוד של 16 תווים לפחות)
GROW_WEBHOOK_SECRET=
# אופציונלי: ה-webhookKey ש-Grow שולחת בכל הודעה (אם מוגדר - הודעה בלעדיו נדחית)
GROW_WEBHOOK_KEY=
# 🎁 מבצע השקה: עד התאריך הזה (כולל, שעון ישראל) פתוחים PROMO_FREE_MODULES מודולים בחינם,
# ואחריו חוזרים אוטומטית ל-FREE_MODULES
PROMO_FREE_MODULES=
PROMO_UNTIL=
