PORT=5000
MONGO_URI=mongodb://localhost:27017/lms_academy
SHEETDB_URL=https://sheetdb.io/api/v1/your_sheet_id
OPENAI_API_KEY=your_openai_api_key
# אופציונלי: דומיין חיצוני שמורשה לקרוא ל-API (למשל אתר נחיתה נפרד). ריק = רק האתר עצמו
ALLOWED_ORIGIN=
# חומת תשלום: קודי גישה מופרדים בפסיקים (ליצירה: npm run codes -- 20). ריק = כל המודולים פתוחים
ACCESS_CODES=
# כמה מודולים ראשונים פתוחים בחינם (ברירת מחדל 3)
FREE_MODULES=3
# קישור לעמוד התשלום שיוצג על מודולים נעולים (אופציונלי)
CHECKOUT_URL=
